APP_ENV=development
# Used only for optional local Docker Compose development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/diamond_pinterest
# Replit supplies its own DATABASE_URL automatically instead of loading this file.
# APP_SECRET_KEY can be set as a Replit Secret; SESSION_SECRET is accepted as a fallback.
PUBLISHING_ENABLED=false
PINTEREST_WRITE_SCOPE_ENABLED=false
PINTEREST_SINGLE_PIN_PILOT_ENABLED=false
PINTEREST_SINGLE_PIN_PILOT_PUBLICATION_ID=
PINTEREST_SINGLE_PIN_PILOT_PUBLICATION_FINGERPRINT=
PINTEREST_SINGLE_PIN_PILOT_REQUEST_FINGERPRINT=

# Store subdomain only, for example: diamond-shelf
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback when Client Credentials is not configured.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5173/integrations/pinterest/callback
PINTEREST_API_BASE=https://api.pinterest.com/v5

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=diamond-shelf-pinterest
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

AI_PROVIDER=none
OPENAI_API_KEY=
