modules = ["nodejs-24", "python-base-3.12", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "unzip", "zlib"]

[userenv]

[userenv.shared]
AI_PROVIDER = "none"
APP_ENV = "development"
PUBLISHING_ENABLED = "false"

[userenv.production]
AI_PROVIDER = "none"
OBJECT_STORAGE_READINESS_MANAGEMENT_ENABLED = "false"
OBJECT_STORAGE_READINESS_PROBE_ENABLED = "false"
ROUTINE_SCHEDULER_CANARY_ENABLED = "false"
ROUTINE_PINTEREST_BATCH_SIZE = "1"
ROUTINE_PINTEREST_DAILY_WRITE_LIMIT = "1"
PUBLISHING_ENABLED = "false"
BUFFER_PUBLISHING_ENABLED = "false"
BUFFER_SINGLE_PIN_PILOT_ENABLED = "false"
PINTEREST_SINGLE_PIN_PILOT_ENABLED = "false"
PINTEREST_WRITE_SCOPE_ENABLED = "false"
PINTEREST_BOARD_WRITE_SCOPE_ENABLED = "false"
ROUTINE_PINTEREST_SCHEDULER_ENABLED = "false"
ROUTINE_PINTEREST_WORKER_ENABLED = "false"
ROUTINE_BUFFER_DISPATCH_ENABLED = "false"
ROUTINE_AUTONOMOUS_AUTHORIZATION_ENABLED = "false"
PINTEREST_PORTFOLIO_PLANNER_ENABLED = "false"
PINTEREST_PORTFOLIO_ACTIVATION_ENABLED = "false"
PINTEREST_OPTIMIZER_ENABLED = "false"
PINTEREST_OPTIMIZER_APPLY_ENABLED = "false"
PINTEREST_SEO_BRIEF_PERSISTENCE_ENABLED = "false"
PINTEREST_ANALYTICS_INGESTION_ENABLED = "false"
PINTEREST_LEARNING_SNAPSHOT_PERSISTENCE_ENABLED = "false"
PINTEREST_AUTONOMOUS_GENERATION_ENABLED = "false"
PINTEREST_AUTONOMOUS_EXECUTION_ENABLED = "false"
PINTEREST_AUTONOMOUS_BOARD_ENSURE_ENABLED = "false"
PINTEREST_BOARD_PROVISIONING_ENABLED = "false"
ROUTINE_SCHEDULED_AUTONOMY_ENABLED = "false"
ROUTINE_SCHEDULED_LIVE_ADMISSION_ENABLED = "false"
ROUTINE_PINTEREST_DRY_RUN = "true"

[deployment]
deploymentTarget = "autoscale"
build = ["python", "scripts/replit_release_build.py"]
run = ["env", "AI_PROVIDER=none", "OBJECT_STORAGE_READINESS_MANAGEMENT_ENABLED=false", "OBJECT_STORAGE_READINESS_PROBE_ENABLED=false", "ROUTINE_SCHEDULER_CANARY_ENABLED=false", "ROUTINE_PINTEREST_BATCH_SIZE=1", "ROUTINE_PINTEREST_DAILY_WRITE_LIMIT=1", "PUBLISHING_ENABLED=false", "BUFFER_PUBLISHING_ENABLED=false", "BUFFER_SINGLE_PIN_PILOT_ENABLED=false", "PINTEREST_SINGLE_PIN_PILOT_ENABLED=false", "PINTEREST_WRITE_SCOPE_ENABLED=false", "PINTEREST_BOARD_WRITE_SCOPE_ENABLED=false", "ROUTINE_PINTEREST_SCHEDULER_ENABLED=false", "ROUTINE_PINTEREST_WORKER_ENABLED=false", "ROUTINE_BUFFER_DISPATCH_ENABLED=false", "ROUTINE_AUTONOMOUS_AUTHORIZATION_ENABLED=false", "PINTEREST_PORTFOLIO_PLANNER_ENABLED=false", "PINTEREST_PORTFOLIO_ACTIVATION_ENABLED=false", "PINTEREST_OPTIMIZER_ENABLED=false", "PINTEREST_OPTIMIZER_APPLY_ENABLED=false", "PINTEREST_SEO_BRIEF_PERSISTENCE_ENABLED=false", "PINTEREST_ANALYTICS_INGESTION_ENABLED=false", "PINTEREST_LEARNING_SNAPSHOT_PERSISTENCE_ENABLED=false", "PINTEREST_AUTONOMOUS_GENERATION_ENABLED=false", "PINTEREST_AUTONOMOUS_EXECUTION_ENABLED=false", "PINTEREST_AUTONOMOUS_BOARD_ENSURE_ENABLED=false", "PINTEREST_BOARD_PROVISIONING_ENABLED=false", "ROUTINE_SCHEDULED_AUTONOMY_ENABLED=false", "ROUTINE_SCHEDULED_LIVE_ADMISSION_ENABLED=false", "ROUTINE_PINTEREST_DRY_RUN=true", "python", "scripts/start_production.py"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[objectStorage]
defaultBucketID = "replit-objstore-6bf25bda-533c-44c4-a4e8-6a3a33a0b339"
